# Copy to .env and change these before running.
# Web console sign-in token. Anyone with it can audit conflicts and broadcast.
HQ_ADMIN_TOKEN=change-this-to-a-long-random-string
POSTGRES_PASSWORD=change-this-too
# Port on this machine for the HQ server.
HQ_PORT=8000
# Leave empty to use the demo HQ key that the current app build trusts.
HQ_SEED_HEX=
# Conflict rules: different triage within N minutes; one patient at two venues within N hours.
CONFLICT_WINDOW_MIN=10
VENUE_WINDOW_H=12
